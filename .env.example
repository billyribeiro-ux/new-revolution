# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@localhost:5432/db-name"

ORIGIN="http://localhost:5173"

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET="dev-only-better-auth-secret-32-chars-minimum"

# TEMPORARY (docs/TEMPORARY.md T2): local admin account created by `pnpm db:seed-admin`.
# Placeholder values only. Never commit real credentials; the seed refuses NODE_ENV=production.
ADMIN_SEED_EMAIL="admin@example.test"
ADMIN_SEED_PASSWORD="replace-with-at-least-12-chars"

# Media storage (docs/MEDIA_STORAGE.md). Placeholders only.
# Production: Vercel Blob read/write token (Vercel dashboard > Storage > Blob > .env.local tab).
BLOB_READ_WRITE_TOKEN=
# Optional: "blob" or "disk". Unset = Blob when the token is set, else local disk in development;
# production/Vercel without a token refuses to upload. "disk" stores under .data/media (single server only).
MEDIA_STORAGE=

# Verified reopening waitlist. Capture is disabled until explicitly enabled.
WAITLIST_SIGNUPS_ENABLED=false
WAITLIST_ORIGIN=https://www.revolutiontradingpros.com
WAITLIST_FROM_EMAIL=
WAITLIST_REPLY_TO=support@revolutiontradingpros.com
# Connect a verified sending domain before enabling capture. Never put real keys in this file.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Vercel sends this as the Bearer token for authenticated worker/cron requests.
CRON_SECRET=
# Dedicated 32-byte hex AES key. Generate with crypto.randomBytes(32).toString('hex').
WAITLIST_ENCRYPTION_KEY=
# Only used while draining an explicitly migrated v0 outbox during key rotation.
WAITLIST_PREVIOUS_ENCRYPTION_KEY=
# Independent random key, at least 32 characters; not an auth secret.
WAITLIST_RATE_LIMIT_KEY=
# Required outside VERCEL_ENV=production; comma-separated controlled recipients only.
WAITLIST_TEST_RECIPIENTS=
