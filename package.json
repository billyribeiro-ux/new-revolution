{
	"name": "new-revolution-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": "26.13.0",
		"pnpm": ">=10.0.0",
		"npm": "please-use-pnpm",
		"yarn": "please-use-pnpm",
		"bun": "please-use-pnpm"
	},
	"scripts": {
		"dev": "vp dev",
		"build": "vp build && node scripts/maintenance-build.mjs",
		"preview": "vp preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:css": "node scripts/check-css-tokens.mjs",
		"check:pages": "node scripts/check-prerendered-pages.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "vp fmt --check . && vp lint . && eslint \"**/*.svelte\"",
		"format": "vp fmt .",
		"test:unit": "vp test",
		"test": "pnpm run test:unit --run && pnpm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"test:seo": "playwright test tests/seo/seo-standard.spec.ts",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed-admin": "node --env-file-if-exists=.env scripts/seed-admin.ts",
		"db:import-posts": "node --env-file-if-exists=.env scripts/import-markdown-posts.ts",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.15",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-vercel": "^7.0.2",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/d3": "^7.4.3",
		"@types/node": "^26.6.6",
		"@types/sanitize-html": "^2.16.2",
		"@types/three": "^0.187.0",
		"@vitest/browser-playwright": "catalog:",
		"auth": "^1.7.15",
		"better-auth": "^1.7.15",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.14.0",
		"mdsvex": "^0.12.8",
		"playwright": "^1.64.1",
		"postgres": "^4.0.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:",
		"vitest-browser-svelte": "3.1.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": [
			"./src/lib/*",
			"./src/lib/*.ts",
			"./src/lib/*/index.ts"
		]
	},
	"dependencies": {
		"@fontsource-variable/montserrat": "^5.3.0",
		"@fontsource-variable/sofia-sans": "^5.3.0",
		"@threlte/core": "^8.7.0",
		"@threlte/extras": "^9.23.1",
		"@tiptap/core": "^3.32.2",
		"@tiptap/extension-character-count": "^3.32.2",
		"@tiptap/extension-color": "^3.32.2",
		"@tiptap/extension-highlight": "^3.32.2",
		"@tiptap/extension-image": "^3.32.2",
		"@tiptap/extension-link": "^3.32.2",
		"@tiptap/extension-placeholder": "^3.32.2",
		"@tiptap/extension-subscript": "^3.32.2",
		"@tiptap/extension-superscript": "^3.32.2",
		"@tiptap/extension-table": "^3.32.2",
		"@tiptap/extension-table-cell": "^3.32.2",
		"@tiptap/extension-table-header": "^3.32.2",
		"@tiptap/extension-table-row": "^3.32.2",
		"@tiptap/extension-task-item": "^3.32.2",
		"@tiptap/extension-task-list": "^3.32.2",
		"@tiptap/extension-text-align": "^3.32.2",
		"@tiptap/extension-text-style": "^3.32.2",
		"@tiptap/extension-typography": "^3.32.2",
		"@tiptap/extension-underline": "^3.32.2",
		"@tiptap/extension-youtube": "^3.32.2",
		"@tiptap/pm": "^3.32.2",
		"@tiptap/starter-kit": "^3.32.2",
		"@vercel/blob": "^2.8.2",
		"carbon-icons-svelte": "^13.17.0",
		"d3": "^7.9.0",
		"gsap": "^3.15.0",
		"phosphor-svelte": "^3.1.1",
		"resend": "^6.37.0",
		"sanitize-html": "^2.18.1",
		"sharp": "^0.35.5",
		"shiki": "^4.6.0",
		"svelte-meta-tags": "^5.0.3",
		"three": "^0.187.0",
		"valibot": "^1.5.0",
		"zod": "^4.6.7"
	}
}
