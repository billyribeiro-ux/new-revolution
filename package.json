{
	"name": "new-revolution-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": ">=24.0.0",
		"pnpm": ">=10.0.0",
		"npm": "please-use-pnpm",
		"yarn": "please-use-pnpm",
		"bun": "please-use-pnpm"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:css": "node scripts/check-css-tokens.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "pnpm run test:unit --run && pnpm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-vercel": "^7.0.1",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.6",
		"@types/three": "^0.186.0",
		"@vitest/browser-playwright": "5.0.5",
		"auth": "^1.7.14",
		"better-auth": "^1.7.14",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"mdsvex": "^0.12.8",
		"playwright": "^1.64.1",
		"postgres": "^3.4.9",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "5.0.5",
		"vitest-browser-svelte": "3.1.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource-variable/montserrat": "^5.3.0",
		"@fontsource-variable/sofia-sans": "^5.3.0",
		"@threlte/core": "^8.6.1",
		"@threlte/extras": "^9.22.4",
		"carbon-icons-svelte": "^13.17.0",
		"gsap": "^3.15.0",
		"phosphor-svelte": "^3.1.1",
		"svelte-meta-tags": "^5.0.3",
		"three": "^0.186.1",
		"valibot": "^1.5.0"
	}
}
