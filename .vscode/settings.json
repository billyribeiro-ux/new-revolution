{
	"typescript.tsdk": "node_modules/typescript/lib",
	"files.saveConflictResolution": "overwriteFileOnDisk",
	"files.watcherExclude": {
		"**/.git/objects/**": true,
		"**/.git/subtree-cache/**": true,
		"**/node_modules/**": true,
		"**/.svelte-kit/**": true,
		"**/build/**": true,
		"**/.pglite/**": true,
		"**/test-results/**": true,
		"**/playwright-report/**": true
	}
}
